# 数据库（本地用 docker-compose 启动的 Postgres，端口 5432）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aigc_prompt

# Redis（本地用 docker-compose 启动的 Redis，端口 6379）
REDIS_URL=redis://localhost:6379/0

# JWT（生产环境务必替换成随机生成的强密钥，不要用示例值）
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# Google OAuth（去 Google Cloud Console 创建 OAuth Client ID 后填入）
GOOGLE_CLIENT_ID=
# Google 官方证书地址；服务器无法直连时可改为可信 HTTPS 证书中转地址，不能关闭验签
GOOGLE_CERTS_URL=https://www.googleapis.com/oauth2/v1/certs

# 微信小程序（纯 wx.login，不是网站扫码登录；AppSecret 禁止放入前端或聊天）
# 未注册时留空；接口明确返回 503，不模拟登录成功。注册后在服务端配置并重启。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 邮件服务 Resend（https://resend.com 注册后获取）
RESEND_API_KEY=
EMAIL_FROM=noreply@aigc-prompt.com

# 腾讯云 COS（图片存储，审核通过转正式内容时上传配图，去 https://console.cloud.tencent.com/cos
# 创建 Bucket，https://console.cloud.tencent.com/cam/capi 创建密钥后填入）
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
# 自定义 CDN 域名（接了 CDN 加速后再填；留空则直接用 COS 默认访问域名）
COS_CDN_DOMAIN=

# 应用基础配置
APP_ENV=development
# CORS 允许的来源列表：产品主站 + 本地起的后台管理面板（admin-panel/，默认用
# python3 -m http.server 5500 启动）。本地跑后台管理面板时记得把它的实际地址也加进来。
CORS_ORIGINS=["http://localhost:3000","http://localhost:5500"]

# 后台管理鉴权（调用 /api/admin/* 接口时，请求头需带 X-Admin-Key: 这个值，生产环境务必换成随机强密钥）
ADMIN_SECRET_KEY=CHANGE_ME_IN_PRODUCTION

# MediaCrawler 本机路径（后台"一键采集"功能用 subprocess 调用它，与本项目平级的独立目录）
MEDIACRAWLER_DIR=~/Desktop/MediaCrawler
